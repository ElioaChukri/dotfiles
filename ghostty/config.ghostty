# Looks
theme = Ayu Mirage
font-family = "Monaspace Krypton"
font-size = 12
background-opacity = 0.9
cursor-style = block
# The shell integration sets a bar cursor at the prompt. This feature turns that off.
shell-integration-features = no-cursor

font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

