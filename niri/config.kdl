// niri reloads this file when you save it. A reload bind is not necessary.

input {
    keyboard {
        xkb {
            options "caps:escape"
        }
        repeat-delay 250
        repeat-rate 50
    }
    touchpad {
        tap
        middle-emulation
        // The touchpad is off while you type.
        dwt
    }

    // A second press of the same workspace number goes back to the previous workspace.
    workspace-auto-back-and-forth

    // The focus follows the pointer, but the view does not scroll for it.
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 3000
}

// A middle click does not paste the selected text.
clipboard {
    disable-primary
}

switch-events {
    lid-close { spawn "dms" "ipc" "call" "lock" "lock"; }
}

spawn-at-startup "dms" "run"

// Applications draw no title bar.
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    always-center-single-column
    gaps 8
    center-focused-column "never"

    // Mod+R cycles through these widths.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // DMS sets the colors in dms/colors.kdl.
    focus-ring {
        width 2
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "top"
        gap 4
        width 4
        length total-proportion=1.0
        gaps-between-tabs 4
        corner-radius 4
    }
}

animations {
    // A value above 1 makes all animations slower. Use it to examine one.
    // slowdown 3.0

    // A damping ratio below 1 makes the motion pass its target a little, then settle.
    workspace-switch {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.001
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=600 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=600 epsilon=0.0001
    }
}

// These values apply to each blurred surface.
blur {
    passes 3
    offset 3
    noise 0.03
    saturation 1.5
}

recent-windows {
    highlight {
        padding 30
        corner-radius 10
    }
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    // The focus ring must not show through a transparent window.
    draw-border-with-background false
}

// The blur shows because ghostty sets background-opacity below 1.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#

    background-effect {
        blur true
    }
}

// A floating window blurs the windows below it, not only the wallpaper.
// niri marks this mode as experimental.
window-rule {
    match is-floating=true

    background-effect {
        xray false
    }
}

// Always open firefox maximized
window-rule {
    match app-id=r#"firefox$"#
    exclude title="^Picture-in-Picture$"

    open-maximized true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"

    open-floating true
}

// The overview shows the blurred DMS wallpaper behind the workspaces.
layer-rule {
    match namespace="dms:blurwallpaper"

    place-within-backdrop true
}

binds {
    // applications
    Mod+Return  { spawn "ghostty"; }
    Mod+B       { spawn "firefox"; }
    Mod+Space   { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Comma   { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+N       { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+X       { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Shift+P { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Shift+E { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // screenshots
    Mod+Shift+S { screenshot; }
    Print       { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // media, volume, brightness
    XF86AudioPlay         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioNext         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioMute         allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5"; }

    // windows
    Mod+Shift+Q     repeat=false { close-window; }
    Mod+F           { maximize-column; }
    Mod+Shift+F     { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Ctrl+Space  { switch-focus-between-floating-and-tiling; }

    // At the edge of a workspace, H and L go to the next monitor.
    // At the edge of a column, J and K go to the next workspace.
    Mod+H { focus-column-or-monitor-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }

    // columns
    Mod+W            { toggle-column-tabbed-display; }
    // Put the window into the adjacent column, or take it out of its column.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+C            { center-column; }
    Mod+Ctrl+F       { expand-column-to-available-width; }

    // overview
    Mod+O repeat=false { toggle-overview; }

    // monitors
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // workspaces
    // A number selects a workspace on the focused monitor.
    Mod+U       { focus-workspace-down; }
    Mod+I       { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp   { focus-column-left; }
    // The cooldown limits one turn of the wheel to one workspace.
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // session
    Mod+Shift+Slash { show-hotkey-overlay; }
    // An application such as a remote desktop client can take the binds. This bind takes them back.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
}

// DMS writes these files. An include overrides the options above it.
include optional=true "dms/colors.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/outputs.kdl"

// This file holds the settings of one machine. It is not in the repository.
include optional=true "local.kdl"
